//@version=6
// =============================================================================
// Trading System - Multi-Strategy Intraday Long Framework
// Currently active module: SPY/QQQ VWAP Pullback Long (Core Version)
//
// PURPOSE
//   Backtesting / paper-trading research only. This is NOT investment advice
//   and is not intended for unattended live trading.
//
// ARCHITECTURE
//   This script is organized as a small "framework" plus one active
//   "strategy module" (VWAP Pullback Long). The framework provides pieces
//   any future strategy module can reuse:
//     - a shared StrategyState type (each module owns one persistent
//       instance, so no two modules can ever read/write each other's state)
//     - a shared `sharedRuntime.activeId` marker recording which module
//       currently owns the single open position allowed system-wide
//     - shared utility functions (symbol filter, backtest date range,
//       position sizing math, stop-buffer math, ET day/time helpers)
//   Each strategy module (VWAP Pullback Long today; more later) is fully
//   self-contained: its own "Enable" input, its own unique setup id string,
//   its own inputs (grouped under its own name in Settings), its own
//   trend/setup/entry/stop/target/sizing/execution/reporting functions, and
//   its own daily counters filtered by its own setup id so it can never be
//   affected by another module's trades. See the "FUTURE STRATEGY MODULES"
//   section near the bottom for the exact pattern to follow when adding one.
//
//   Only one position may be open at a time across the WHOLE script
//   (pyramiding = 0, and every module checks canOpenNewPosition() before
//   entering). This is a deliberate account-level constraint shared by all
//   modules, not a per-module limit.
//
// ORDER-FILL ASSUMPTIONS (read this before trusting any backtest numbers)
//   1. Entries: a module's confirmation candle is evaluated only after it
//      has CLOSED (barstate.isconfirmed). The entry order is a market order
//      submitted on that same confirmed bar, and because the strategy is
//      declared with process_orders_on_close = true, it is filled AT THAT
//      BAR'S CLOSE, plus configured slippage. No future bar's data is used
//      to decide or price the entry.
//   2. Stops / targets: submitted immediately after the entry fills, as a
//      static OCA stop + limit bracket (strategy.exit). TradingView's
//      broker emulator fills these intrabar, using each subsequent bar's
//      high/low, exactly like a real resting stop/limit order would. This
//      is realistic and is NOT lookahead bias because only that bar's own
//      high/low (which only exist once the bar has printed) are used.
//   3. Force-close at the end of a module's entry window: evaluated on
//      confirmed bars only, so on a 5-minute chart the force-close can
//      occur up to ~5 minutes after the configured cutoff (the close of
//      the bar that contains/crosses the cutoff time).
//   4. No higher-timeframe or daily data is requested anywhere (no
//      request.security calls), so there is no possibility of using a
//      still-forming daily high/low before it has actually occurred.
// =============================================================================

// commission_value and slippage below must be compile-time constants - Pine
// does not allow input.*() calls for these two strategy() arguments (unlike
// most other parameters). Adjust them for your own broker/fill assumptions
// directly here, or override per-run via the Strategy Tester's
// Properties tab (Commission / Slippage fields), which does not require
// editing the script.
strategy(
     "Trading System - Intraday Long Framework",
     shorttitle              = "VWAPPBLong",
     overlay                  = true,
     pyramiding               = 0,
     initial_capital           = 5000,      // keep in sync with each module's own bankroll input (see docs)
     default_qty_type          = strategy.fixed,
     default_qty_value         = 1,
     currency                  = currency.USD,
     commission_type            = strategy.commission.percent,
     commission_value           = 0.0,      // % per trade - edit here or in Properties tab
     slippage                   = 1,        // ticks per fill - edit here or in Properties tab
     process_orders_on_close    = true,
     calc_on_every_tick         = false)

// =============================================================================
// GLOBAL / ACCOUNT-LEVEL SETTINGS (shared by every module)
// =============================================================================

allowOtherSymbolsInput = input.bool(false, "Allow Other Symbols (default: SPY/QQQ only)", group = "Global Settings")
// input.time()'s defval must be a compile-time constant, and timestamp(...)
// calls are never "const" in Pine (even with literal arguments) - so the
// defaults below are literal Unix millisecond timestamps instead:
// 1577836800000 = 2020-01-01 00:00 UTC, 4102444740000 = 2099-12-31 23:59 UTC.
// Change the actual dates via Settings -> Inputs after adding to chart.
startDateInput = input.time(1577836800000, "Backtest Start Date", group = "Backtest Settings")
endDateInput   = input.time(4102444740000, "Backtest End Date",   group = "Backtest Settings")

// =============================================================================
// SHARED TYPES
// =============================================================================

// One instance of this type belongs to exactly one strategy module. Holding
// setup-machine state, trade bracket levels, and daily counters in a single
// per-module object (rather than a pile of loose global variables) is what
// guarantees two modules can never accidentally read or overwrite each
// other's state, even if they are both enabled and running at once.
type StrategyState
    string id                    = ""
    int    setupStage            = 0     // 0=trend,1=impulse,2=pullback,3=confirmation,4=trade active
    float  impulseHigh           = na
    int    impulseBarIdx         = na
    float  pullbackLow           = na
    bool   pullbackValid         = false
    int    pullbackBarIdx        = na
    string lastInvalidationReason = "N/A"
    float  entryPrice            = na
    float  stopPrice             = na
    float  targetPrice           = na
    float  lastRiskDollars       = na
    int    lastDayId             = na
    int    dayClosedTrades       = 0
    int    dayLosingTrades       = 0
    float  dayRealizedPnL        = 0.0
    bool   dayHitBigWin          = false
    int    prevClosedTradesCount = 0
    // Chart-marker signals: true only on the bar the event fires. Pine does
    // not allow a function to reassign a plain global scalar it only sees
    // via closure - only fields of a reference type (this UDT) it was
    // handed as a parameter - so these live on the state object instead of
    // as bare `vwapPB_xSignal` globals, and are explicitly zeroed each bar.
    bool   impulseMarkerSignal      = false
    bool   pullbackMarkerSignal     = false
    bool   confirmationMarkerSignal = false
    bool   entrySignal              = false

// =============================================================================
// SHARED RUNTIME STATE
// =============================================================================

// Records which module's setup id currently owns the single open position
// allowed system-wide. na when flat. Every module must check this (via
// canOpenNewPosition() / its own id comparison) before managing a position,
// so modules never step on each other's trades.
// Wrapped in a tiny UDT (a reference type) for the same reason as the
// marker signals above: a plain `var string` cannot be reassigned from
// inside a function even via closure, but a field of an object handed to
// (or, for a single global like this, simply visible to) a function can be.
type SharedRuntime
    string activeId = na

var SharedRuntime sharedRuntime = SharedRuntime.new()

// =============================================================================
// SHARED UTILITY FUNCTIONS (usable by any strategy module)
// =============================================================================

isAllowedSymbol(allowOther) =>
    allowOther or syminfo.ticker == "SPY" or syminfo.ticker == "QQQ"

inBacktestRange(startDate, endDate) =>
    time >= startDate and time <= endDate

// True only when the whole script is flat - the shared, account-level
// "one open position at a time" gate every module's entry logic must pass.
canOpenNewPosition() =>
    strategy.position_size == 0

// Generic risk-based + capital-capped share sizing, floored to whole shares.
calcPositionSize(entryPx, riskPerShare, maxRiskDollars, maxTradeValue) =>
    sharesByRisk    = math.floor(maxRiskDollars / riskPerShare)
    sharesByCapital = math.floor(maxTradeValue / entryPx)
    math.min(sharesByRisk, sharesByCapital)

// Minimum stop buffer: the greater of 1 minimum tick or 0.01% of price.
minStopBuffer(price) =>
    math.max(syminfo.mintick, price * 0.0001)

// Minutes elapsed since Eastern Time midnight for the current bar.
etMinutesOfDay() =>
    hour(time, "America/New_York") * 60 + minute(time, "America/New_York")

// A numeric id that changes once per Eastern Time calendar day.
etDayId() =>
    year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")

// =============================================================================
// MODULE: VWAP Pullback Long        (setup id: "VWAPPullbackLong")
// =============================================================================

VWAP_PB_ID = "VWAPPullbackLong"

// --- Inputs -----------------------------------------------------------------
vwapPB_enableInput = input.bool(true, "Enable VWAP Pullback Long", group = "VWAP Pullback Long")

vwapPB_entryStartHourInput   = input.int(9,  "Entry Window Start Hour (ET, 24h)",   minval = 0, maxval = 23, group = "VWAP Pullback Long: Trading Window")
vwapPB_entryStartMinuteInput = input.int(45, "Entry Window Start Minute (ET)",      minval = 0, maxval = 59, group = "VWAP Pullback Long: Trading Window")
vwapPB_entryEndHourInput     = input.int(11, "Entry Window End / Force-Close Hour (ET, 24h)", minval = 0, maxval = 23, group = "VWAP Pullback Long: Trading Window")
vwapPB_entryEndMinuteInput   = input.int(15, "Entry Window End / Force-Close Minute (ET)",    minval = 0, maxval = 59, group = "VWAP Pullback Long: Trading Window")

vwapPB_ema9LenInput  = input.int(9,  "Fast EMA Length", minval = 1, group = "VWAP Pullback Long: Indicators")
vwapPB_ema20LenInput = input.int(20, "Slow EMA Length", minval = 1, group = "VWAP Pullback Long: Indicators")
vwapPB_atrLenInput   = input.int(14, "ATR Length",      minval = 1, group = "VWAP Pullback Long: Indicators")

vwapPB_impulsePricePctInput = input.float(0.15, "Impulse: Min % High Above VWAP",           minval = 0.0, step = 0.01, group = "VWAP Pullback Long: Impulse")
vwapPB_impulseAtrMultInput  = input.float(0.5,  "Impulse: Min ATR Multiple High Above VWAP", minval = 0.0, step = 0.05, group = "VWAP Pullback Long: Impulse")

vwapPB_pullbackMaxBarsInput          = input.int(15,   "Pullback: Max Bars After Impulse",          minval = 1,   group = "VWAP Pullback Long: Pullback")
vwapPB_pullbackTolerancePctInput     = input.float(0.10, "Pullback: Low Proximity to VWAP (%)",       minval = 0.0, step = 0.01, group = "VWAP Pullback Long: Pullback")
vwapPB_pullbackMaxCloseBelowPctInput = input.float(0.05, "Pullback: Max Candle Close Below VWAP (%)",  minval = 0.0, step = 0.01, group = "VWAP Pullback Long: Pullback")
vwapPB_invalidationPctInput          = input.float(0.20, "Invalidation: Material Close Below VWAP (%)", minval = 0.0, step = 0.01, group = "VWAP Pullback Long: Pullback")
vwapPB_vwapFallingBarsInput          = input.int(2, "Invalidation: VWAP Falling Bar Streak", minval = 1, group = "VWAP Pullback Long: Pullback")

vwapPB_confirmMinBodyPctInput   = input.float(50, "Confirmation: Min Body % of Bar Range", minval = 0, maxval = 100, step = 1, group = "VWAP Pullback Long: Confirmation")
vwapPB_confirmationMaxBarsInput = input.int(5, "Confirmation: Max Bars After Pullback", minval = 1, group = "VWAP Pullback Long: Confirmation")

vwapPB_maxStopDistancePctInput = input.float(0.30, "Max Stop Distance (% of Entry Price)", minval = 0.01, step = 0.01, group = "VWAP Pullback Long: Stop Loss")

vwapPB_targetRMultipleInput = input.float(2.0, "Target R Multiple", minval = 0.1, step = 0.1, group = "VWAP Pullback Long: Profit Target")

vwapPB_bankrollInput       = input.float(5000, "Simulated Bankroll ($) - keep in sync with Initial Capital property", minval = 1, group = "VWAP Pullback Long: Position Sizing")
vwapPB_maxRiskDollarsInput  = input.float(25,   "Max Risk Per Trade ($)", minval = 1, group = "VWAP Pullback Long: Position Sizing")
vwapPB_maxTradeValueInput   = input.float(5000, "Max Trade Value ($)",    minval = 1, group = "VWAP Pullback Long: Position Sizing")

vwapPB_maxTradesPerDayInput       = input.int(2,  "Max Trades Per Day",            minval = 1, group = "VWAP Pullback Long: Daily Limits")
vwapPB_maxLosingTradesPerDayInput = input.int(2,  "Max Losing Trades Per Day",     minval = 1, group = "VWAP Pullback Long: Daily Limits")
vwapPB_maxDailyLossDollarsInput   = input.float(50, "Max Daily Realized Loss ($)", minval = 1, group = "VWAP Pullback Long: Daily Limits")

// Temporary pre-test diagnostics only - never affects trading logic, never
// reads anything the strategy doesn't already compute. Off by default.
vwapPB_debugEnableInput = input.bool(false, "Enable Debug Visuals (temporary, for testing)", group = "VWAP Pullback Long: Debug")

vwapPB_windowStartMin = vwapPB_entryStartHourInput * 60 + vwapPB_entryStartMinuteInput
vwapPB_windowEndMin   = vwapPB_entryEndHourInput * 60 + vwapPB_entryEndMinuteInput

// --- Module state -------------------------------------------------------------
var StrategyState vwapPBState = StrategyState.new(id = VWAP_PB_ID)

// --- Indicators (module-specific: VWAP / 9-20 EMA / ATR) ----------------------
vwapPB_vwapVal  = ta.vwap(hlc3)
vwapPB_ema9Val  = ta.ema(close, vwapPB_ema9LenInput)
vwapPB_ema20Val = ta.ema(close, vwapPB_ema20LenInput)
vwapPB_atrVal   = ta.atr(vwapPB_atrLenInput)

// ta.falling()/ta.crossunder() maintain internal history keyed to their own
// CALL SITE, not to the chart's bar index - if called only from inside a
// conditional branch (e.g. only while setupStage is 2/3), their "previous
// bar" is actually "the last bar this branch happened to run," which is
// wrong. They are therefore evaluated here, unconditionally, every bar, and
// only the resulting booleans are consumed conditionally below.
vwapPB_vwapFallingNow  = ta.falling(vwapPB_vwapVal, vwapPB_vwapFallingBarsInput)
vwapPB_emaCrossDownNow = ta.crossunder(vwapPB_ema9Val, vwapPB_ema20Val)

// --- Trend detection ------------------------------------------------------
vwapPB_detectTrend(vwapVal, vwapPrev, ema9Val, ema20Val) =>
    close > vwapVal and vwapVal > vwapPrev and ema9Val > ema20Val

// --- Setup detection: impulse -----------------------------------------------
vwapPB_detectImpulse(vwapVal, atrVal) =>
    high >= vwapVal * (1 + vwapPB_impulsePricePctInput / 100) or high >= vwapVal + vwapPB_impulseAtrMultInput * atrVal

// --- Setup detection: pullback -----------------------------------------------
vwapPB_detectPullback(vwapVal) =>
    lowNearVwap = math.abs(low - vwapVal) <= vwapVal * (vwapPB_pullbackTolerancePctInput / 100)
    closeOK     = close >= vwapVal * (1 - vwapPB_pullbackMaxCloseBelowPctInput / 100)
    lowNearVwap and closeOK

// Invalidates an in-progress setup (post-impulse) without requiring every
// original trend condition to keep holding on every pullback bar. Any ONE
// of these is enough to kill the setup before entry:
//   - VWAP is clearly falling (a configurable consecutive down-bar streak)
//   - the 9 EMA crosses below the 20 EMA
//   - price closes below the configurable material-VWAP-break threshold
// vwapFallingNow / emaCrossDownNow must be pre-computed unconditionally
// (see Indicators section above) and simply passed in here. Returns
// [isInvalid, reason] so the caller can both act on it and record why.
vwapPB_isInvalidated(vwapVal, vwapFallingNow, emaCrossDownNow) =>
    materialBreak = close <= vwapVal * (1 - vwapPB_invalidationPctInput / 100)
    reason  = "None"
    invalid = false
    if vwapFallingNow
        reason  := "VWAP Falling"
        invalid := true
    else if emaCrossDownNow
        reason  := "EMA Cross Down"
        invalid := true
    else if materialBreak
        reason  := "Material VWAP Break"
        invalid := true
    [invalid, reason]

// --- Confirmation / entry trigger --------------------------------------------
vwapPB_checkConfirmation(vwapVal) =>
    bodyRange = high - low
    bodySize  = math.abs(close - open)
    bodyOK    = bodyRange > 0 and (bodySize / bodyRange) >= (vwapPB_confirmMinBodyPctInput / 100)
    close > open and close > high[1] and close > vwapVal and bodyOK

// --- Stop calculation ---------------------------------------------------------
// Returns [stopPrice, riskPerShare, isValid]
vwapPB_calcStop(pullbackLow, entryPx) =>
    stop        = pullbackLow - minStopBuffer(entryPx)
    risk        = entryPx - stop
    stopDistPct = entryPx > 0 ? (risk / entryPx * 100) : 100.0
    valid       = stop < entryPx and risk > 0 and stopDistPct <= vwapPB_maxStopDistancePctInput
    [stop, risk, valid]

// --- Target calculation ---------------------------------------------------
vwapPB_calcTarget(entryPx, riskPerShare) =>
    entryPx + vwapPB_targetRMultipleInput * riskPerShare

// --- Daily / account trading gate --------------------------------------------
vwapPB_canTradeToday(state) =>
    state.dayClosedTrades < vwapPB_maxTradesPerDayInput and state.dayLosingTrades < vwapPB_maxLosingTradesPerDayInput and state.dayRealizedPnL > -vwapPB_maxDailyLossDollarsInput and not state.dayHitBigWin

// --- Trade execution -----------------------------------------------------
vwapPB_executeEntry(state, runtime, entryPx, stopPx, targetPx, shares) =>
    state.entryPrice      := entryPx
    state.stopPrice        := stopPx
    state.targetPrice      := targetPx
    state.lastRiskDollars  := (entryPx - stopPx) * shares
    strategy.entry(state.id, strategy.long, qty = shares)
    strategy.exit(state.id + "Exit", from_entry = state.id, stop = stopPx, limit = targetPx)
    runtime.activeId := state.id
    state.setupStage := 4

// --- Setup reset -----------------------------------------------------------
vwapPB_resetSetup(state) =>
    state.setupStage    := 0
    state.impulseHigh    := na
    state.impulseBarIdx  := na
    state.pullbackLow    := na
    state.pullbackValid  := false
    state.pullbackBarIdx := na

// --- Daily reset (new Eastern Time day) --------------------------------------
vwapPB_manageDailyReset(state) =>
    today = etDayId()
    if na(state.lastDayId) or today != state.lastDayId
        state.dayClosedTrades := 0
        state.dayLosingTrades := 0
        state.dayRealizedPnL  := 0.0
        state.dayHitBigWin    := false
        // Daily counters always reset at the day boundary, but the setup
        // machine itself is only reset if no trade is active - mirrors the
        // same guard used by the session-end reset, so a still-open
        // position (e.g. an unexpected multi-day gap) can never be desynced
        // from strategy.position_size by this reset.
        if state.setupStage != 4
            vwapPB_resetSetup(state)
        state.lastDayId := today

// --- Closed-trade accounting -------------------------------------------------
// Filters strategy.closedtrades by this module's own entry id, so a future
// module's trades can never be miscounted into this module's daily stats.
vwapPB_updateDailyStats(state) =>
    if strategy.closedtrades > state.prevClosedTradesCount
        for i = state.prevClosedTradesCount to strategy.closedtrades - 1
            if strategy.closedtrades.entry_id(i) == state.id
                tradeProfit = strategy.closedtrades.profit(i)
                state.dayRealizedPnL += tradeProfit
                state.dayClosedTrades += 1
                if tradeProfit <= 0
                    state.dayLosingTrades += 1
                if not na(state.lastRiskDollars) and state.lastRiskDollars > 0 and (tradeProfit / state.lastRiskDollars) >= vwapPB_targetRMultipleInput
                    state.dayHitBigWin := true
        state.prevClosedTradesCount := strategy.closedtrades

// --- Exit / session management -----------------------------------------------
vwapPB_manageExit(state, runtime, forceCloseTime) =>
    if strategy.position_size > 0 and runtime.activeId == state.id and forceCloseTime
        strategy.close(state.id, comment = "Force Close (Window End)")
    if runtime.activeId == state.id and strategy.position_size == 0
        vwapPB_resetSetup(state)
        runtime.activeId := na

// --- Debug helpers (read-only; never influence trading logic) ----------------
// Human-readable label for the raw setup-stage number.
vwapPB_stateLabel(stage) =>
    switch stage
        0 => "0: Waiting Trend"
        1 => "1: Waiting Impulse"
        2 => "2: Waiting Pullback"
        3 => "3: Waiting Confirmation"
        4 => "4: Trade Active"
        => "Unknown"

// Why new entries are currently locked out for the rest of the day, if they
// are. Mirrors vwapPB_canTradeToday's logic exactly, just spelled out.
vwapPB_dailyLockoutReason(state) =>
    reason = "None"
    if state.dayHitBigWin
        reason := "Big Win Reached (>= " + str.tostring(vwapPB_targetRMultipleInput) + "R)"
    else if state.dayLosingTrades >= vwapPB_maxLosingTradesPerDayInput
        reason := "Max Losing Trades (" + str.tostring(state.dayLosingTrades) + ")"
    else if state.dayRealizedPnL <= -vwapPB_maxDailyLossDollarsInput
        reason := "Max Daily Loss ($" + str.tostring(state.dayRealizedPnL, "#.##") + ")"
    else if state.dayClosedTrades >= vwapPB_maxTradesPerDayInput
        reason := "Max Trades Per Day (" + str.tostring(state.dayClosedTrades) + ")"
    reason

// --- Module driver: ties the whole pipeline together for one bar -------------
// Called unconditionally, every bar (see MAIN EXECUTION below) - the
// confirmed-bar gate lives INSIDE the function instead of at its call site.
// Pine flags conditionally-invoked function calls (CW10003) as an
// inconsistency risk; moving the gate inside satisfies that while behaving
// identically, since the body only ever does anything when isConfirmed.
runVwapPullbackLong(state, runtime, allowedSymbol, dateRangeOK, isConfirmed) =>
    if isConfirmed
        // Reporting signals reset every confirmed bar; the state machine
        // below sets the relevant one true only on the bar its event fires.
        state.impulseMarkerSignal      := false
        state.pullbackMarkerSignal     := false
        state.confirmationMarkerSignal := false
        state.entrySignal              := false

        // Book-keeping (daily reset, exit handling, stats) always runs, even
        // if the module is disabled, so an already-open trade is never
        // abandoned.
        vwapPB_manageDailyReset(state)
        forceCloseTime = etMinutesOfDay() >= vwapPB_windowEndMin
        vwapPB_manageExit(state, runtime, forceCloseTime)
        vwapPB_updateDailyStats(state)

        if forceCloseTime and state.setupStage != 4
            vwapPB_resetSetup(state)

        // Scanning is also gated on "not forceCloseTime": without this, a
        // setup reset by the line above could immediately re-advance from
        // stage 0 to stage 1 later in this same bar's pass through the
        // chain below (if trendOK happened to be true), then get reset
        // again next bar, forever flickering for the rest of the day
        // instead of staying idle. No trade could ever result from this
        // (entryWindow below is already false), but the flicker is real
        // state churn and would be misleading in the debug panel, so
        // scanning is simply switched off once the window has closed.
        if vwapPB_enableInput and not forceCloseTime
            trendOK = vwapPB_detectTrend(vwapPB_vwapVal, vwapPB_vwapVal[1], vwapPB_ema9Val, vwapPB_ema20Val)

            if state.setupStage == 0
                if trendOK
                    state.setupStage := 1

            else if state.setupStage == 1
                if not trendOK
                    vwapPB_resetSetup(state)
                else
                    if vwapPB_detectImpulse(vwapPB_vwapVal, vwapPB_atrVal)
                        state.impulseHigh   := high
                        state.impulseBarIdx := bar_index
                        state.pullbackLow   := na
                        state.pullbackValid := false
                        state.impulseMarkerSignal := true
                        state.setupStage := 2

            else if state.setupStage == 2
                // Expiration window 1: the pullback itself must occur within
                // vwapPB_pullbackMaxBarsInput bars of the qualifying impulse.
                barsSinceImpulse = bar_index - state.impulseBarIdx
                [isInvalid2, invalidReason2] = vwapPB_isInvalidated(vwapPB_vwapVal, vwapPB_vwapFallingNow, vwapPB_emaCrossDownNow)
                if barsSinceImpulse > vwapPB_pullbackMaxBarsInput
                    vwapPB_resetSetup(state)
                else if isInvalid2
                    state.lastInvalidationReason := invalidReason2
                    vwapPB_resetSetup(state)
                else
                    if vwapPB_detectPullback(vwapPB_vwapVal)
                        state.pullbackLow    := low
                        state.pullbackValid  := true
                        state.pullbackBarIdx := bar_index
                        state.pullbackMarkerSignal := true
                        state.setupStage := 3

            else if state.setupStage == 3
                state.pullbackLow := math.min(state.pullbackLow, low)
                // Expiration window 2: separate and independent from the
                // pullback window above - confirmation must occur within
                // vwapPB_confirmationMaxBarsInput bars of the qualifying pullback.
                barsSincePullback = bar_index - state.pullbackBarIdx
                [isInvalid3, invalidReason3] = vwapPB_isInvalidated(vwapPB_vwapVal, vwapPB_vwapFallingNow, vwapPB_emaCrossDownNow)
                if barsSincePullback > vwapPB_confirmationMaxBarsInput
                    vwapPB_resetSetup(state)
                else if isInvalid3
                    state.lastInvalidationReason := invalidReason3
                    vwapPB_resetSetup(state)
                else
                    if vwapPB_checkConfirmation(vwapPB_vwapVal)
                        state.confirmationMarkerSignal := true

                        candidateEntryPrice = close
                        [candidateStop, candidateRisk, riskValid] = vwapPB_calcStop(state.pullbackLow, candidateEntryPrice)

                        entryWindow    = etMinutesOfDay() >= vwapPB_windowStartMin and etMinutesOfDay() < vwapPB_windowEndMin
                        allowedToTrade = allowedSymbol and timeframe.isintraday and entryWindow and dateRangeOK and vwapPB_canTradeToday(state) and canOpenNewPosition()

                        if riskValid and allowedToTrade
                            shares = calcPositionSize(candidateEntryPrice, candidateRisk, vwapPB_maxRiskDollarsInput, vwapPB_maxTradeValueInput)
                            if shares >= 1
                                targetPx = vwapPB_calcTarget(candidateEntryPrice, candidateRisk)
                                vwapPB_executeEntry(state, runtime, candidateEntryPrice, candidateStop, targetPx, shares)
                                state.entrySignal := true
                            else
                                vwapPB_resetSetup(state)
                        else
                            vwapPB_resetSetup(state)

// =============================================================================
// FUTURE STRATEGY MODULES
//
// To add a new strategy without touching any VWAP Pullback Long code:
//   1. Pick a unique setup id string, e.g. MY_STRATEGY_ID = "MyStrategyName".
//   2. Add an "Enable <Strategy Name>" input plus that module's own inputs,
//      each with group = "<Strategy Name>: <Section>" so they appear in
//      their own block in Settings.
//   3. Declare its own state:  var StrategyState myStrategyState =
//      StrategyState.new(id = MY_STRATEGY_ID)
//   4. Write its own myStrategy_detectTrend / _detectSetup / _checkEntry /
//      _calcStop / _calcTarget / _executeEntry / _resetSetup /
//      _manageDailyReset / _updateDailyStats / _manageExit functions,
//      mirroring the vwapPB_* functions above. Reuse the shared utilities
//      (isAllowedSymbol, inBacktestRange, canOpenNewPosition,
//      calcPositionSize, minStopBuffer, etMinutesOfDay, etDayId) instead of
//      duplicating them. Any function that needs to WRITE to
//      sharedRuntime.activeId (only entry/exit management should) must
//      receive `runtime` as an explicit parameter, same as `state` - Pine
//      does not allow reassigning a field through a variable seen only via
//      closure from inside a function in every Pine version, only through
//      one passed in as a parameter, so don't rely on closure access for
//      any `:=` write, only for reads.
//   5. Write a runMyStrategy(state, runtime, allowedSymbol, dateRangeOK,
//      isConfirmed) driver function following the same shape as
//      runVwapPullbackLong above - gate its entire body on `isConfirmed`
//      internally rather than wrapping its call site in
//      `if barstate.isconfirmed`, then call it unconditionally every bar
//      from the MAIN EXECUTION block below, passing sharedRuntime and
//      barstate.isconfirmed through.
//   6. Add its own plot()/plotshape() calls in its own "Visuals" block,
//      reading signal fields off its own state object (see
//      StrategyState.impulseMarkerSignal etc. for the pattern) rather than
//      bare globals, for the same reason as point 4.
// Because every module reads/writes only its own StrategyState instance and
// filters strategy.closedtrades by its own unique id, this can be done
// without any risk of interfering with VWAP Pullback Long's state, daily
// counters, or trades - the only shared resource is the single open-position
// slot (sharedRuntime.activeId / canOpenNewPosition()), by design.
// =============================================================================

// =============================================================================
// MAIN EXECUTION
//
// Driver functions are called unconditionally, every bar - each one gates
// its own body internally on barstate.isconfirmed (passed in below), which
// is what "confirmed bars only / no repainting / no lookahead" actually
// requires, without triggering Pine's conditional-call-site warning.
// =============================================================================

allowedSymbol = isAllowedSymbol(allowOtherSymbolsInput)
dateRangeOK   = inBacktestRange(startDateInput, endDateInput)

runVwapPullbackLong(vwapPBState, sharedRuntime, allowedSymbol, dateRangeOK, barstate.isconfirmed)
// Future modules: runMyStrategy(myStrategyState, sharedRuntime, allowedSymbol, dateRangeOK, barstate.isconfirmed)

// =============================================================================
// WARNINGS (shared)
// =============================================================================

bgcolor(not timeframe.isintraday ? color.new(color.orange, 85) : na, title = "Non-Intraday Warning")

if barstate.islast and not timeframe.isintraday
    label.new(bar_index, high, "WARNING: designed for 1-5 minute intraday charts only.", style = label.style_label_down, color = color.orange, textcolor = color.white, size = size.small)

if barstate.islast and not isAllowedSymbol(allowOtherSymbolsInput)
    label.new(bar_index, low, "WARNING: symbol is not SPY/QQQ - entries disabled (Allow Other Symbols = false).", style = label.style_label_up, color = color.red, textcolor = color.white, size = size.small)

// =============================================================================
// MODULE: VWAP Pullback Long - Visuals / Reporting
// =============================================================================

plot(vwapPB_vwapVal,  title = "VWAP Pullback Long: Session VWAP", color = color.new(color.blue, 0),   linewidth = 2)
plot(vwapPB_ema9Val,  title = "VWAP Pullback Long: 9 EMA",        color = color.new(color.orange, 0), linewidth = 1)
plot(vwapPB_ema20Val, title = "VWAP Pullback Long: 20 EMA",       color = color.new(color.purple, 0), linewidth = 1)

vwapPB_ownsPosition = strategy.position_size > 0 and sharedRuntime.activeId == vwapPBState.id
plot(vwapPB_ownsPosition ? vwapPBState.stopPrice   : na, title = "VWAP Pullback Long: Stop Loss",     color = color.new(color.red, 0),   style = plot.style_linebr, linewidth = 1)
plot(vwapPB_ownsPosition ? vwapPBState.targetPrice : na, title = "VWAP Pullback Long: Profit Target", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 1)

plotshape(vwapPBState.impulseMarkerSignal,      title = "VWAP Pullback Long: Impulse",      style = shape.circle,      location = location.abovebar, color = color.new(color.aqua, 0),   size = size.tiny)
plotshape(vwapPBState.pullbackMarkerSignal,     title = "VWAP Pullback Long: Pullback",     style = shape.circle,      location = location.belowbar, color = color.new(color.yellow, 0), size = size.tiny)
plotshape(vwapPBState.confirmationMarkerSignal, title = "VWAP Pullback Long: Confirmation", style = shape.diamond,     location = location.belowbar, color = color.new(color.teal, 0),   size = size.tiny)
plotshape(vwapPBState.entrySignal,              title = "VWAP Pullback Long: Entry",        style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0),   size = size.small)

// =============================================================================
// MODULE: VWAP Pullback Long - DEBUG VISUALS (temporary, for testing only)
//
// Off by default (Enable Debug Visuals). Purely diagnostic: reads state
// already computed above and never influences any trading decision. Numeric
// values are exposed as Data Window-only plots so they can be inspected bar
// by bar (including while scrubbing through history); the two text reasons
// are shown in a small table snapshot of the most recent bar. Intended to be
// removed (or just left disabled) once testing is complete.
// =============================================================================

vwapPB_debugState             = vwapPB_debugEnableInput ? vwapPBState.setupStage : na
vwapPB_debugImpulseBarIdx     = vwapPB_debugEnableInput ? vwapPBState.impulseBarIdx : na
vwapPB_debugPullbackBarIdx    = vwapPB_debugEnableInput ? vwapPBState.pullbackBarIdx : na
vwapPB_debugBarsSinceImpulse  = vwapPB_debugEnableInput and not na(vwapPBState.impulseBarIdx)  ? bar_index - vwapPBState.impulseBarIdx  : na
vwapPB_debugBarsSincePullback = vwapPB_debugEnableInput and not na(vwapPBState.pullbackBarIdx) ? bar_index - vwapPBState.pullbackBarIdx : na

plot(vwapPB_debugState,             title = "Debug: State Number",         display = display.data_window)
plot(vwapPB_debugImpulseBarIdx,     title = "Debug: Impulse Bar Index",    display = display.data_window)
plot(vwapPB_debugPullbackBarIdx,    title = "Debug: Pullback Bar Index",   display = display.data_window)
plot(vwapPB_debugBarsSinceImpulse,  title = "Debug: Bars Since Impulse",   display = display.data_window)
plot(vwapPB_debugBarsSincePullback, title = "Debug: Bars Since Pullback",  display = display.data_window)

var table vwapPB_debugTable = table.new(position.bottom_right, 2, 8, border_width = 1, border_color = color.gray)

if vwapPB_debugEnableInput and barstate.islast
    table.cell(vwapPB_debugTable, 0, 0, "VWAP Pullback Long - DEBUG", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 0, "", bgcolor = color.new(color.gray, 30))
    table.cell(vwapPB_debugTable, 0, 1, "State",                 text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 1, vwapPB_stateLabel(vwapPBState.setupStage), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 0, 2, "Impulse Bar Index",     text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 2, na(vwapPBState.impulseBarIdx)  ? "-" : str.tostring(vwapPBState.impulseBarIdx),  text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 0, 3, "Pullback Bar Index",    text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 3, na(vwapPBState.pullbackBarIdx) ? "-" : str.tostring(vwapPBState.pullbackBarIdx), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 0, 4, "Bars Since Impulse",    text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 4, na(vwapPBState.impulseBarIdx)  ? "-" : str.tostring(bar_index - vwapPBState.impulseBarIdx),  text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 0, 5, "Bars Since Pullback",   text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 5, na(vwapPBState.pullbackBarIdx) ? "-" : str.tostring(bar_index - vwapPBState.pullbackBarIdx), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 0, 6, "Last Invalidation Reason", text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 6, vwapPBState.lastInvalidationReason, text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 0, 7, "Daily Lockout Reason",  text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(vwapPB_debugTable, 1, 7, vwapPB_dailyLockoutReason(vwapPBState), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
